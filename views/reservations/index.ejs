<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="brand">StudySphere</a>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/reservations">Reservations</a>
      <a href="/reservations/new">Book a Room</a>
    </div>
  </nav>

  <main class="dashboard">
    <h1>My Reservations</h1>
    <p>View your current study room bookings.</p>

    <a href="/reservations/new" class="primary-button">Book a Room</a>

    <% if (reservations.length === 0) { %>
      <p>No reservations yet. Create your first booking!</p>
    <% } else { %>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Student Name</th>
              <th>Study Room</th>
              <th>Date</th>
              <th>Start Time</th>
              <th>End Time</th>
            </tr>
          </thead>
          <tbody>
            <% reservations.forEach(function(reservation) { %>
              <tr>
                <td><%= reservation.studentName %></td>
                <td><%= reservation.room %></td>
                <td><%= reservation.date %></td>
                <td><%= reservation.startTime %></td>
                <td><%= reservation.endTime %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
